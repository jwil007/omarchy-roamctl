#!/bin/bash

# Pin bin/roamctl-omarchy to a roamctl release: download every archive the
# installer may fetch, record their SHA-256 digests, and rewrite the
# ROAMCTL_VERSION / ROAMCTL_SHA256 block. Maintainer tool; the plugin never
# runs it. Review the diff, then commit.
#
#   tools/pin-roamctl v1.3.8

set -euo pipefail

tag="${1:-}"
[[ $tag =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: tools/pin-roamctl vX.Y.Z" >&2; exit 1; }

repo="jwil007/roamctl"
target="$(dirname "$(readlink -f "$0")")/../bin/roamctl-omarchy"
base="https://github.com/$repo/releases/download/$tag"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

cd "$tmp"
curl -fsSL "$base/roamctl_${tag#v}_checksums.txt" -o checksums.txt
block="ROAMCTL_VERSION=\"$tag\"
declare -A ROAMCTL_SHA256=("
for name in roamctl roamctl-tui; do
  for arch in amd64 arm64 arm; do
    archive="${name}_${arch}.tar.gz"
    curl -fsSL "$base/$archive" -o "$archive"
    # Cross-check against the release's own checksums as a sanity check.
    grep " $archive\$" checksums.txt | sha256sum -c --quiet
    block+="
  [$archive]=$(sha256sum "$archive" | cut -d' ' -f1)"
  done
done
block+="
)"
tar -tzf roamctl_amd64.tar.gz systemd/roamctl@.service >/dev/null ||
  { echo "$tag archives don't include the systemd unit" >&2; exit 1; }

BLOCK="$block" perl -0pi -e 's/ROAMCTL_VERSION="[^"]*"\ndeclare -A ROAMCTL_SHA256=\(\n.*?\n\)/$ENV{BLOCK}/s' "$target"
bash -n "$target"
echo "Pinned $tag in bin/roamctl-omarchy. Review with: git diff"
