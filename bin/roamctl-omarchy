#!/bin/bash

# Omarchy glue for roamctl (https://github.com/jwil007/roamctl).
#
#   roamctl-omarchy install [--yes]   install/upgrade roamctl + roamctl-tui to the pinned release below
#   roamctl-omarchy setup [--yes]     (re)install the socket/config permissions drop-in and polkit rule
#   roamctl-omarchy uninstall         remove roamctl and everything install added, then optionally
#                                     the config, roam log, and this plugin
#   roamctl-omarchy status [iface]    JSON status for the shell plugin
#   roamctl-omarchy enable [iface]    enable + start roamctl@iface
#   roamctl-omarchy disable [iface]   disable + stop roamctl@iface
#   roamctl-omarchy restart [iface]   restart roamctl@iface (e.g. after a config edit)
#   roamctl-omarchy tui [iface]       open roamctl-tui in a terminal
#   roamctl-omarchy config [iface]    edit /etc/roamctl/<iface>.toml, validate, then restart the service
#   roamctl-omarchy apply <iface> section.key=value...
#                                     validate + write config values, restart if running (JSON result)
#   roamctl-omarchy logs [iface]      follow the service journal in a terminal
#   roamctl-omarchy export [iface]    write the roam log (scored scan list per roam) to a CSV in Downloads
#
# When [iface] is omitted, the first wireless interface is used.

set -euo pipefail

REPO="jwil007/roamctl"

# The roamctl release this plugin installs, and the SHA-256 of every archive
# it may download. Downloads are checked against these digests, not against
# anything fetched from the release, so this file alone decides what gets
# installed. Update both together with tools/pin-roamctl <tag>.
ROAMCTL_VERSION="v1.3.7"
declare -A ROAMCTL_SHA256=(
  [roamctl_amd64.tar.gz]=7e059b012736afdfedd4c2bb956bb4872e2dc29b0e39a27114fa8a183ec18583
  [roamctl_arm64.tar.gz]=22d7ef872058391a56a0ba5b87ab495858802c77d9d6281377202d62d2fad339
  [roamctl_arm.tar.gz]=3105bca77aab2b2f0f2610997b37d413a3313e03234b55e30e1208a9812f5f36
  [roamctl-tui_amd64.tar.gz]=31e0192e718f7c409268a3f05ec906cf94647fd8b3b98de3d9cab0c0586a0239
  [roamctl-tui_arm64.tar.gz]=7e9e80c8e95320341d4ebdff003abc7558f8a4fb9825a5641afda420b7e284c4
  [roamctl-tui_arm.tar.gz]=697fd68aec53b54ba1fdbb3e3c66fa628bde7d46cb6fcfe3fa85b753e1629e9d
)
BIN_DIR="/usr/local/bin"
UNIT_PATH="/etc/systemd/system/roamctl@.service"
DROPIN_DIR="/etc/systemd/system/roamctl@.service.d"
DROPIN_PATH="$DROPIN_DIR/omarchy.conf"
POLKIT_RULE="/etc/polkit-1/rules.d/50-roamctl-omarchy.rules"
CONFIG_DIR="/etc/roamctl"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/roamctl-omarchy"
SETUP_VERSION=2
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CONFIG_TOOL="$(dirname "$SELF")/roamctl-config"
EXPORT_TOOL="$(dirname "$SELF")/roamctl-export"

roam_log() {
  echo "$STATE_DIR/roams-$1.jsonl"
}

fail() {
  echo "roamctl-omarchy: $*" >&2
  exit 1
}

default_iface() {
  local dev
  for dev in /sys/class/net/*; do
    if [[ -d $dev/wireless ]]; then
      basename "$dev"
      return
    fi
  done
}

resolve_iface() {
  local iface="${1:-}"
  [[ -n $iface ]] || iface="$(default_iface)"
  [[ -n $iface ]] || fail "no wireless interface found"
  [[ $iface =~ ^[A-Za-z0-9_.-]+$ ]] || fail "invalid interface name: $iface"
  echo "$iface"
}

installed_version() {
  if [[ -x $BIN_DIR/roamctl ]]; then
    "$BIN_DIR/roamctl" -version 2>/dev/null || echo "unknown"
  fi
}

# Run a command in a floating Omarchy terminal (install, config edit, etc.).
in_terminal() {
  exec omarchy-launch-floating-terminal-with-presentation "$*"
}

cmd_status() {
  local iface active enabled version setup config logged
  iface="$(resolve_iface "${1:-}")"
  logged="$({ cat "$(roam_log "$iface")" "$STATE_DIR/roams-$iface.1.jsonl" 2>/dev/null || true; } | wc -l)"
  version="$(installed_version)"
  config="$CONFIG_DIR/$iface.toml"
  setup="$(sed -n 's/^# roamctl-omarchy setup v\([0-9]*\)$/\1/p' "$DROPIN_PATH" 2>/dev/null || true)"
  active="$(systemctl is-active "roamctl@$iface" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "roamctl@$iface" 2>/dev/null || true)"
  jq -cn \
    --arg iface "$iface" \
    --arg version "$version" \
    --arg active "$active" \
    --arg enabled "$enabled" \
    --argjson unit "$([[ -f $UNIT_PATH ]] && echo true || echo false)" \
    --argjson dropin "$([[ -f $DROPIN_PATH ]] && echo true || echo false)" \
    --argjson tui "$([[ -x $BIN_DIR/roamctl-tui ]] && echo true || echo false)" \
    --arg config "$config" \
    --argjson configExists "$([[ -f $config ]] && echo true || echo false)" \
    --argjson configWritable "$([[ -w $config ]] && echo true || echo false)" \
    --argjson setup "${setup:-0}" \
    --argjson setupWanted "$SETUP_VERSION" \
    --argjson logged "${logged:-0}" \
    '{
      iface: $iface,
      installed: ($version != "" and $unit),
      version: $version,
      tuiInstalled: $tui,
      socketAccess: $dropin,
      active: ($active == "active"),
      activeState: $active,
      enabled: ($enabled == "enabled"),
      config: $config,
      configExists: $configExists,
      configWritable: $configWritable,
      setupCurrent: ($setup >= $setupWanted),
      roamsLogged: $logged
    }'
}

cmd_install() {
  if [[ ${1:-} != --yes && ! -t 0 ]]; then
    in_terminal "$SELF install --yes"
  fi

  local arch goarch current tmp iface
  arch="$(uname -m)"
  case "$arch" in
    x86_64) goarch=amd64 ;;
    aarch64 | arm64) goarch=arm64 ;;
    armv6* | armv7* | armhf) goarch=arm ;;
    *) fail "unsupported architecture: $arch" ;;
  esac

  current="$(installed_version)"
  echo "Installing roamctl $ROAMCTL_VERSION${current:+ (installed: $current)}"

  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  local base="https://github.com/$REPO/releases/download/$ROAMCTL_VERSION"
  local name archive digest
  for name in roamctl roamctl-tui; do
    archive="${name}_${goarch}.tar.gz"
    digest="${ROAMCTL_SHA256[$archive]:-}"
    [[ -n $digest ]] || fail "no pinned digest for $archive"
    echo "Downloading $archive"
    curl -fsSL "$base/$archive" -o "$tmp/$archive"
    (cd "$tmp" && echo "$digest  $archive" | sha256sum -c --quiet) ||
      fail "$archive does not match the digest pinned in this plugin"
    tar -xzf "$tmp/$archive" -C "$tmp" "$name"
  done
  # The unit ships inside the verified roamctl archive.
  tar -xzf "$tmp/roamctl_${goarch}.tar.gz" -C "$tmp" systemd/roamctl@.service ||
    fail "roamctl $ROAMCTL_VERSION archive has no systemd unit"

  echo "Installing to $BIN_DIR (sudo)"
  sudo install -Dm755 "$tmp/roamctl" "$BIN_DIR/roamctl"
  sudo install -Dm755 "$tmp/roamctl-tui" "$BIN_DIR/roamctl-tui"
  sudo install -Dm644 "$tmp/systemd/roamctl@.service" "$UNIT_PATH"
  install_permissions "$tmp"

  iface="$(default_iface)"
  if [[ -n $iface ]] && systemctl is-active --quiet "roamctl@$iface"; then
    echo "Restarting roamctl@$iface"
    sudo systemctl restart "roamctl@$iface"
  fi

  echo
  echo "roamctl $ROAMCTL_VERSION installed. Toggle it from the roamctl bar widget, or:"
  echo "  roamctl-omarchy enable${iface:+ $iface}"
}

# Upstream creates the IPC socket and config as root-only. The drop-in hands
# both to the wheel group (who can already sudo) so the bar widget,
# roamctl-tui, and quick tuning work without a password. The socket is
# broadcast-only: roamctl never reads from it. The config is read once at
# startup, so writing it while roamctl runs is safe; a restart applies it.
write_dropin() {
  cat >"$1" <<EOF
# Installed by the jwil007.roamctl Omarchy plugin.
# roamctl-omarchy setup v$SETUP_VERSION
[Service]
ExecStartPre=-/usr/bin/rm -f /run/roamctl/%i.sock
ExecStartPost=/bin/sh -c 'for n in \$\$(seq 100); do if [ -S /run/roamctl/%i.sock ]; then chgrp wheel /run/roamctl/%i.sock && chmod 0660 /run/roamctl/%i.sock; [ -f $CONFIG_DIR/%i.toml ] && chgrp wheel $CONFIG_DIR/%i.toml && chmod 0664 $CONFIG_DIR/%i.toml; exit 0; fi; sleep 0.1; done; exit 0'
EOF
}

# Lets an active local wheel session start/stop/restart roamctl@ units
# without a password prompt. Enabling/disabling (unit files) still prompts.
write_polkit_rule() {
  cat >"$1" <<'EOF'
// Installed by the jwil007.roamctl Omarchy plugin.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.isInGroup("wheel") && subject.local && subject.active) {
    var unit = action.lookup("unit") || "";
    if (unit.indexOf("roamctl@") == 0) return polkit.Result.YES;
  }
});
EOF
}

# Put roamctl-omarchy on PATH (~/.local/bin) so the commands in the README
# work as written. Plugins can't run install hooks, so install/setup do it.
link_helper() {
  local bin="$HOME/.local/bin"
  mkdir -p "$bin"
  ln -sfn "$SELF" "$bin/roamctl-omarchy"
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) echo "Note: $bin is not on PATH; run $SELF directly." ;;
  esac
}

install_permissions() {
  local tmp="$1" config
  write_dropin "$tmp/omarchy.conf"
  write_polkit_rule "$tmp/roamctl-omarchy.rules"
  sudo install -Dm644 "$tmp/omarchy.conf" "$DROPIN_PATH"
  sudo install -Dm644 "$tmp/roamctl-omarchy.rules" "$POLKIT_RULE"
  for config in "$CONFIG_DIR"/*.toml; do
    [[ -f $config ]] || continue
    sudo chgrp wheel "$config"
    sudo chmod 0664 "$config"
  done
  sudo systemctl daemon-reload
  link_helper
}

cmd_setup() {
  if [[ ${1:-} != --yes && ! -t 0 ]]; then
    in_terminal "$SELF setup --yes"
  fi
  local tmp
  tmp="$(mktemp -d)"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT
  echo "Granting the wheel group access to roamctl's socket and config (sudo)"
  install_permissions "$tmp"
  echo "Done. Quick tuning in the roamctl panel is ready."
}

cmd_uninstall() {
  if [[ ! -t 0 ]]; then
    in_terminal "$SELF uninstall"
  fi
  local units
  units="$(systemctl list-units 'roamctl@*' --all --no-legend --plain | awk '{print $1}')"
  if [[ -n $units ]]; then
    # shellcheck disable=SC2086
    sudo systemctl disable --now $units
  fi
  sudo rm -rf "$DROPIN_DIR" "$UNIT_PATH" "$POLKIT_RULE" "$BIN_DIR/roamctl" "$BIN_DIR/roamctl-tui" /run/roamctl
  rm -f "$HOME/.local/bin/roamctl-omarchy"
  sudo systemctl daemon-reload
  echo "roamctl removed."

  if gum confirm --default=false "Also delete your roamctl config ($CONFIG_DIR) and roam log?"; then
    sudo rm -rf "$CONFIG_DIR"
    rm -rf "$STATE_DIR"
    echo "Config and roam log deleted."
  else
    echo "Config in $CONFIG_DIR and roam log in $STATE_DIR were kept."
  fi

  # Omarchy has no uninstall hook, so offer to remove the plugin from here.
  # This deletes the folder this script lives in, so it must run last.
  local plugin_dir plugin_id
  plugin_dir="$(dirname "$(dirname "$SELF")")"
  plugin_id="$(basename "$plugin_dir")"
  if [[ $plugin_dir == "$HOME/.config/omarchy/plugins/$plugin_id" ]] &&
    gum confirm "Also remove the $plugin_id Omarchy plugin?"; then
    exec omarchy plugin remove "$plugin_id" --yes
  fi
}

# systemctl asks the Omarchy polkit agent for authorization when needed.
cmd_enable() {
  local iface
  iface="$(resolve_iface "${1:-}")"
  systemctl enable --now "roamctl@$iface"
}

cmd_disable() {
  local iface
  iface="$(resolve_iface "${1:-}")"
  systemctl disable --now "roamctl@$iface"
}

cmd_restart() {
  local iface
  iface="$(resolve_iface "${1:-}")"
  systemctl restart "roamctl@$iface"
}

cmd_tui() {
  local iface
  iface="$(resolve_iface "${1:-}")"
  [[ -x $BIN_DIR/roamctl-tui ]] || fail "roamctl-tui is not installed; run: roamctl-omarchy install"
  exec omarchy-launch-or-focus-tui --app-id=org.omarchy.roamctl-tui "$BIN_DIR/roamctl-tui" -iface "$iface"
}

backup_config() {
  mkdir -p "$STATE_DIR"
  cp "$1" "$STATE_DIR/$(basename "$1").prev"
}

# Restart if running and report whether it came back up.
restart_if_active() {
  local iface="$1" n
  systemctl is-active --quiet "roamctl@$iface" || return 2
  systemctl restart "roamctl@$iface" || return 1
  for n in 1 2 3 4 5 6; do
    sleep 0.5
    systemctl is-active --quiet "roamctl@$iface" && return 0
  done
  return 1
}

# Terminal editors run inline; GUI editors need their wait flag so we know
# when the file is closed.
edit_file() {
  local editor
  editor="$(cat "$HOME/.local/state/omarchy/defaults/editor" 2>/dev/null || echo nvim)"
  case "${editor##*/}" in
    nvim | vim | nano | micro | hx | helix) "$editor" "$1" ;;
    code | cursor | zed | subl) "$editor" --wait "$1" ;;
    *) nvim "$1" ;;
  esac
}

cmd_config() {
  local iface file tmp answer status
  iface="$(resolve_iface "${1:-}")"
  if [[ ! -t 0 ]]; then
    in_terminal "$SELF config $iface"
  fi
  file="$CONFIG_DIR/$iface.toml"
  [[ -f $file ]] || fail "$file does not exist yet; start roamctl once to create it"

  # Edit a copy so a half-finished or invalid file never lands in /etc.
  tmp="$(mktemp --suffix=.toml)"
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" EXIT
  cp "$file" "$tmp"
  while true; do
    edit_file "$tmp"
    if cmp -s "$file" "$tmp"; then
      echo "No changes."
      return
    fi
    if "$CONFIG_TOOL" check "$tmp"; then
      break
    fi
    read -rp "Config is invalid. [e]dit again or [d]iscard? " answer
    [[ $answer == [dD]* ]] && { echo "Discarded."; return; }
  done

  backup_config "$file"
  if [[ -w $file ]]; then
    cat "$tmp" >"$file"
  else
    sudo tee "$file" <"$tmp" >/dev/null
  fi
  echo "Saved $file"

  status=0
  restart_if_active "$iface" || status=$?
  case $status in
    0) echo "roamctl@$iface restarted with the new config." ;;
    2) echo "roamctl@$iface is not running; changes apply next time it starts." ;;
    *) echo "roamctl@$iface failed to restart:"; journalctl -u "roamctl@$iface" -n 15 --no-pager -o cat ;;
  esac
}

cmd_apply() {
  local iface file result status
  iface="$(resolve_iface "${1:-}")"
  shift || true
  file="$CONFIG_DIR/$iface.toml"
  [[ -w $file ]] || fail "$file is not writable; run: roamctl-omarchy setup"
  result="$("$CONFIG_TOOL" set "$file" "$@")" || { echo "$result"; exit 1; }

  status=2
  if [[ $(jq -r .changed <<<"$result") == true ]]; then
    status=0
    restart_if_active "$iface" 2>/dev/null || status=$?
  fi
  jq -c --argjson status "$status" '. + {
    restarted: ($status == 0 and .changed),
    ok: (.ok and $status != 1),
    errors: (.errors + (if $status == 1 then ["roamctl failed to restart; check the logs"] else [] end))
  }' <<<"$result"
  [[ $status != 1 ]]
}

# Called by the shell plugin for each completed roam: attach roamctl's own
# journal lines for the roam window (candidate evaluation, measured/required
# delta, result) and append the record to the roam log.
cmd_log_roam() {
  local iface="$1" since="$2" record="$3" log journal
  [[ $since =~ ^[0-9]+$ ]] || fail "log-roam: bad since timestamp"
  iface="$(resolve_iface "$iface")"
  log="$(roam_log "$iface")"
  mkdir -p "$STATE_DIR"
  journal="$(journalctl -u "roamctl@$iface" --since "@$since" --no-pager -o short-iso-precise 2>/dev/null |
    sed -E 's/\x1b\[[0-9;]*m//g; s/^(\S+) \S+ [^:]+: /\1 /' | jq -Rsc 'split("\n") | map(select(length > 0))' || echo '[]')"
  if (($(stat -c %s "$log" 2>/dev/null || echo 0) > 20971520)); then
    mv -f "$log" "${log%.jsonl}.1.jsonl"
  fi
  jq -c --argjson journal "${journal:-[]}" '. + {journal: $journal}' <<<"$record" >>"$log"
}

cmd_export() {
  local iface dir log out
  iface="$(resolve_iface "${1:-}")"
  log="$(roam_log "$iface")"
  dir="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
  [[ -n $dir && -d $dir && $dir != "$HOME" ]] || dir="$HOME/Downloads"
  mkdir -p "$dir"
  out="$dir/roamctl-roams-$iface-$(date +%Y%m%d-%H%M%S).csv"
  "$EXPORT_TOOL" "${log%.jsonl}.1.jsonl" "$log" -o "$out"
}

cmd_logs() {
  local iface
  iface="$(resolve_iface "${1:-}")"
  exec omarchy-launch-tui --app-id=org.omarchy.roamctl-logs journalctl -u "roamctl@$iface" -f -n 200
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  setup) shift; cmd_setup "$@" ;;
  apply) shift; cmd_apply "$@" ;;
  uninstall) shift; cmd_uninstall ;;
  status) shift; cmd_status "$@" ;;
  enable) shift; cmd_enable "$@" ;;
  disable) shift; cmd_disable "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  tui) shift; cmd_tui "$@" ;;
  config) shift; cmd_config "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  export) shift; cmd_export "$@" ;;
  log-roam) shift; cmd_log_roam "$@" ;;
  *) sed -n '3,21p' "$SELF" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
